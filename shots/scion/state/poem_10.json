{"schema":"scion.state/2.0","id":"poem_10","num":"10","title":"MAGIC RIDE","tagline":"night replaced by morning, dot by dot","district":"The Orange Haze","color":"#fa8d15","src_fps":12,"xsheet_fps":24,"frames":168,"seconds":14.0,"assets":{"cel":"assets/poem_10_cel.webp","rough":"assets/poem_10_rough.webp","masks":"assets/poem_10_masks.webp","atlas":{"cols":12,"rows":14,"cell":[384,216],"count":168},"rough_atlas":{"cols":12,"rows":14,"cell":[256,144],"count":168},"mask_atlas":{"cols":14,"rows":1,"cell":[256,144],"count":14},"video":"../video/poem_10/cartoon.mp4"},"cuts":[],"dramatic":{"two_seconds_before":"night replaced by morning, dot by dot. Before frame 1 we are already inside 'HOP ON': the city was moving before the camera arrived, so the opening beat is a stimulus already in progress, not a cold start.","causal_chain":["ANTICIPATION","ACTION_EXTREME","CONTACT_OVERSHOOT","SETTLE"],"beats":[{"id":"B01","role":"ANTICIPATION","heuristic":true,"f_in":0,"f_out":13,"dur_src":13,"dur_24":26,"energy":10.564,"camera_speed":0.03,"sign":"perception","sign_image":"Perception-image","verb":"the body/camera loads against the coming move \u2014 cloud against sky, wall","movement":"HOP ON","line":"I wasn","key_frame":12,"mask_key":12,"opens_on_cut":false},{"id":"B02","role":"ACTION_EXTREME","heuristic":true,"f_in":13,"f_out":55,"dur_src":42,"dur_24":84,"energy":13.309,"camera_speed":0.092,"sign":"action","sign_image":"Action-image (SAS)","verb":"the move reaches its extreme \u2014 floor against cloud, sky","movement":"HEADS TWIST","line":"Loneliness is having everything with no one to tell \u2014 being everywhere, with no one to love. I let the noise block the noise. The way I ride: eyes turn, heads twist \u2014 and prove the magic still exists.","key_frame":51,"mask_key":48,"opens_on_cut":false},{"id":"B03","role":"CONTACT_OVERSHOOT","heuristic":true,"f_in":55,"f_out":112,"dur_src":57,"dur_24":114,"energy":9.112,"camera_speed":0.051,"sign":"reflection","sign_image":"Reflection-image (ASA)","verb":"the move lands and overshoots \u2014 railing against street lamp, wall","movement":"MOON SETTLES","line":"All preparations to live and dream in darkness, I no longer desire. The moon settles, and the tease of distant stars subsides \u2014 and I can see a morning ahead for me.","key_frame":55,"mask_key":60,"opens_on_cut":false},{"id":"B04","role":"SETTLE","heuristic":true,"f_in":112,"f_out":168,"dur_src":56,"dur_24":112,"energy":8.607,"camera_speed":0.042,"sign":"time","sign_image":"Time-image","verb":"the world settles into the aftermath \u2014 the figure against railing, building, fence","movement":"CHILLY MORNING","line":"Riding in a way you can","key_frame":117,"mask_key":120,"opens_on_cut":false}],"keys":[{"id":"K01","frame":12,"beat":"B01","role":"ANTICIPATION","silhouette_key":12},{"id":"K02","frame":51,"beat":"B02","role":"ACTION_EXTREME","silhouette_key":48},{"id":"K03","frame":55,"beat":"B03","role":"CONTACT_OVERSHOOT","silhouette_key":60},{"id":"K04","frame":117,"beat":"B04","role":"SETTLE","silhouette_key":120}],"flip_test":{"mean_key_change":0.075,"reads":true,"note":"keys must differ enough to tell the story with no in-betweens"},"staging_topologies":[{"frame":132,"horizon":0.289,"figure_scale":0.006,"negative_space":0.994,"silhouette_contrast":0.218,"occluder_P0":0.286,"selected":true},{"frame":0,"horizon":0.742,"figure_scale":0.206,"negative_space":0.794,"silhouette_contrast":0.137,"occluder_P0":0.0},{"frame":60,"horizon":0.5,"figure_scale":0,"negative_space":1.0,"silhouette_contrast":null,"occluder_P0":0.617}]},"multiplane":{"z":{"P0":0.2,"P1":0.5,"P2":1.0,"P3":1.2,"P4":2.5,"P5":6.0,"P6":null},"roles":{"P0":"Lens mask / extreme foreground occluders","P1":"Fast foreground elements","P2":"Primary character performance (focal plane)","P3":"Secondary characters, props, cast shadows, contact FX","P4":"Midground set & ground-plane anchor","P5":"Distant background architecture","P6":"Sky dome, atmosphere, volumetric light"},"by_key":[{
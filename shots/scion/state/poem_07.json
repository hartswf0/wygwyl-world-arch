{"schema":"scion.state/2.0","id":"poem_07","num":"07","title":"DJ TURN ME UP","tagline":"amplitude, and eleven petals","district":"Naraka Market","color":"#01acd4","src_fps":12,"xsheet_fps":24,"frames":114,"seconds":9.5,"assets":{"cel":"assets/poem_07_cel.webp","rough":"assets/poem_07_rough.webp","masks":"assets/poem_07_masks.webp","atlas":{"cols":12,"rows":10,"cell":[384,216],"count":114},"rough_atlas":{"cols":12,"rows":10,"cell":[256,144],"count":114},"mask_atlas":{"cols":10,"rows":1,"cell":[256,144],"count":10},"video":"../video/poem_07/cartoon.mp4"},"cuts":[],"dramatic":{"two_seconds_before":"amplitude, and eleven petals. Before frame 1 we are already inside 'CHIN NESTED': the city was moving before the camera arrived, so the opening beat is a stimulus already in progress, not a cold start.","causal_chain":["ANTICIPATION","ACTION_EXTREME","CONTACT_OVERSHOOT","SETTLE","PERCEPTION","SETTLE"],"beats":[{"id":"B01","role":"ANTICIPATION","heuristic":true,"f_in":0,"f_out":25,"dur_src":25,"dur_24":50,"energy":12.058,"camera_speed":0.038,"sign":"affect","sign_image":"Affection-image","verb":"the body/camera loads against the coming move \u2014 the figure against person, wall, floor","movement":"CHIN NESTED","line":"DJ, turn me up, please. Eyes wide shut, chin nested at the arch of the weight of these spoken words.","key_frame":24,"mask_key":24,"opens_on_cut":false},{"id":"B02","role":"ACTION_EXTREME","heuristic":true,"f_in":25,"f_out":54,"dur_src":29,"dur_24":58,"energy":13.47,"camera_speed":0.059,"sign":"action","sign_image":"Action-image (SAS)","verb":"the move reaches its extreme \u2014 the figure against person, wall, floor","movement":"THOUSAND LIGHT YEARS","line":"One by one, treasures escaping \u2014 devaluing themselves after unsullied stars diminished their glares. I walked a thousand light years to be heard. So DJ \u2014 please \u2014 turn me up.","key_frame":51,"mask_key":48,"opens_on_cut":false},{"id":"B03","role":"CONTACT_OVERSHOOT","heuristic":true,"f_in":54,"f_out":68,"dur_src":14,"dur_24":28,"energy":11.163,"camera_speed":0.027,"sign":"reflection","sign_image":"Reflection-image (ASA)","verb":"the move lands and overshoots \u2014 the figure against person, wall, floor","movement":"DIVERGING RINGS","line":"So I can speak: of wedding bands diverging across abstract skies of wounded souls. Of a shared home, boxed and trucked on separate one-way streets \u2014 not built with U-turns, or stop, maybe-we-shouldn","key_frame":54,"mask_key":48,"opens_on_cut":false},{"id":"B04","role":"SETTLE","heuristic":true,"f_in":68,"f_out":80,"dur_src":12,"dur_24":24,"energy":10.685,"camera_speed":0.07,"sign":"mental","sign_image":"Mental / relation-image","verb":"the world settles into the aftermath \u2014 the figure against person, floor, street lamp","movement":"ELEVEN PETALS","line":"A love story of years \u2014 eleven years \u2014 each plunkled off as daisy petals. We love, we not. Of a future gone swiftly, and a past left empty-handed.","key_frame":77,"mask_key":72,"opens_on_cut":false},{"id":"B05","role":"PERCEPTION","heuristic":true,"f_in":80,"f_out":89,"dur_src":9,"dur_24":18,"energy":10.695,"camera_speed":0.069,"sign":"perception","sign_image":"Perception-image","verb":"the change is registered \u2014 the figure against floor, person, street lamp","movement":"THREE ROADS","line":"To pick a road: of heavy rain. Or of frontal fog. Or of dimmed night lights under a cloud \u2014 with a silver lining.","key_frame":81,"mask_key":84,"opens_on_cut":false},{"id":"B06","role":"SETTLE","heuristic":true,"f_in":89,"f_out":114,"dur_src":25,"dur_24":50,"energy":10.553,"camera_speed":0.046,"sign":"time","sign_image":"Time-image","verb":"the world settles into the aftermath \u2014 the figure against wall, floor, person","movement":"CHIN HIGH","line":"Now, turning forth to face delights and shadows \u2014 one night at a time; one tear at a time; one open mic at a time. Chin now nested high, and volume turnt up.","key_frame":107,"mask_key":108,"opens_on_cut":false}],"keys":[{"id":"K01","frame":24,"beat":"B01","role":"ANTICIPATION","silhouette_key":24},{"id":"K02","frame":51,"beat":"B02","role":"ACTION_EXTREME","silhouette_key":48},{"id":"K03","frame":54,"beat":"B03","role":"CONTACT_OVERSHOOT","silhouette_key":48},{"id":"K04","frame":77,"beat":"B04","role":"SETTLE","silhouette_key":72},{"id":"K05","frame":81,"beat":"B05","role":"PERCEPTION","silhouette_key":84},{"id":"K06","frame":107,"beat":"B06","role":"SETTLE","silhouette_key":108}],"flip_test":{"mean_key_change":0.124,"reads":true,"note":"keys must differ enough to tell the story with no in-betweens"},"staging_topologies":[{"frame":108,"horizon":0.0,"figure_scale":0.082,"negative_space":0.918,"silhouette_contrast":0.088,"occluder_P0":0.0,"selected":true},{"frame":72,"horizon":0.803,"figure_scale":0.07,"negative_space":0.93,"silhouette_contrast":0.087,"occluder_P0":0.0},{"frame":60,"horizon":0.239,"figure_scale":0.02,"negative_space":0.98,"silhouette_contrast":0.083,"occluder_P0":0.0}]},"multiplane":{"z":{"P0":0.2,"P1":0.5,"P2":1.0,"P3":1.2,"P4":2.5,"P5":6.0,"P6":null},"roles":{"P0":"Lens mask / extreme foreground occluders","P1":"Fast foreground elements","P2":"Primary character performance (focal plane)","P3":"Secondary characters, props, cast shadows, contact FX","P4":"Midground set & ground-plane anchor","P5":"Distant background architecture","P6":"Sky dome, atmosphere, volumetric light"},"by_key":[{"frame":0,"camera":{"move":"crane_push","why":"auto: chosen from shot grammar","focus":[598,387],"amplitude":0.1,"z_ref_m":7.18},"planes":[{"id":"P0","z_scion":0.2,"role":"Lens mask / extreme foreground occluders","name":"camera mask","area":0.0,"z_m":null,"parallax":null,"haze":null,"contents":[]},{"id":"P1","z_scion":0.5,"role":"Fast foreground elements","name":"foreground","area":0.0,"z_m":null,"parallax":null,"haze":null,"contents":[]},{"id":"P2","z_scion":1.0,"role":"Primary character performance (focal plane)","name":"character action","area":0.161,"z
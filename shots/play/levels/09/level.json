,"particle":"rain","station_id":"st_09_3_2","station_label":"Mother's Living Room","station_part_label":"Mother's Warm Living Room Interior","station_anim":"lamp_glow"},{"t":61.72,"e":64.72,"text":"As my tears fall between the creases and faith,","w0":152,"w1":160,"mx":665.6,"emotion":"vertigo","emotion_label":"Vertigo & Freefall","posture_cue":"fall_arc","particle":"embers","station_id":"st_09_3_1","station_label":"Voice Across the Abyss","station_part_label":"Acoustic Voice Wave Across the Abyss","station_anim":"phone_ring"},{"t":65.38,"e":66.82,"text":"dancing on my own,","w0":161,"w1":164,"mx":329.2,"emotion":"grief","emotion_label":"Carrying the Weight","posture_cue":"kneel_heart","particle":"rain","station_id":"st_09_3_0","station_label":"Calling From the Booth","station_part_label":"Illuminated Harbor Phone Booth","station_anim":"booth_frame"},{"t":67.62,"e":68.72,"text":"maternal ears in tune.","w0":165,"w1":168,"mx":643.6,"emotion":"grief","emotion_label":"Carrying the Weight","posture_cue":"kneel_heart","particle":"rain","station_id":"st_09_3_1","station_label":"Voice Across the Abyss","station_part_label":"Acoustic Voice Wave Across the Abyss","station_anim":"phone_ring"},{"t":70.52,"e":72.78,"text":"She watches us gather my things to go.","w0":169,"w1":176,"mx":998.4,"emotion":"grief","emotion_label":"Carrying the Weight","posture_cue":"kneel_heart","particle":"rain","station_id":"st_09_3_2","station_label":"Mother's Living Room","station_part_label":"Mother's Warm Living Room Interior","station_anim":"lamp_glow"}],"pieces":17,"missing_pieces":0,"emotion":"departure","progress_ratio":0.6,"plan_id":"P09-S04","set_name":"the quay path east","camera_framing":"wide","district_name":"Cenotaph Rail","palette_glow":["#f06629","#a94022","#cf5124","#f98335"],"backdrop_file":"../world/ef9f6c7e_3/backdrop.webp","archive_poster":"../cel_assets/posters/P09-011.jpg","world_planes":[{"file":"../world/ef9f6c7e_3/S00_P6.webp","plane":"P6","z":16.91,"label":"sky / atmosph
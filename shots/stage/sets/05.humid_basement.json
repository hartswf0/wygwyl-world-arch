{
 "id": "humid_basement",
 "poem": "05",
 "name": "the humid basement bedroom",
 "look": "low shared basement: bare concrete floor, two courses of damp cinderblock, Southern-pine joists overhead joined like the constellation, a window well with two named stars, a thin mattress pad",
 "light": "dim, one warm bulb; starlight blue in the window well; humidity as beads on the block, not fog",
 "dossier_layers": {
  "sky": "window well: a slice of night with two stars",
  "back": "cinderblock wall, joints as gaps, beads of damp",
  "mid": "pine joists with punched joist plates and grade stamps carrying the ancestors' names",
  "front": "the edge of the mattress pad",
  "floor": "concrete, top-down"
 },

{
 "id": "atlantis_waterfront",
 "poem": "06",
 "name": "the rising waterfront",
 "look": "wet marble domes and towers surfacing with green and pink neon, water streaming off, vines on the terraces",
 "light": "cold blue turning warm as windows come on; neon reflections in the falling water",

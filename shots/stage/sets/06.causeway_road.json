{
 "id": "causeway_road",
 "poem": "06",
 "name": "the yellow-brick causeway",
 "look": "a yellow-brick road laid as a surface (not a ladder) running out over black water to a vanishing point where two spire tips and a dome break the surface",
 "light": "night as a tone, not bare paper; the bricks lit warm by the elder's lantern; neon tips on the spires",
 "dossier_layers": {
  "sky": "night tone with comets crossing toward the dome",
  "back": "the drowned city: spire tips above the waterline",
  "mid": "the file of travellers walking away",
  "front": "bricks at the road's near end, the poet stepping on",
  "floor": "water plane with reflections either side of the road"
 },

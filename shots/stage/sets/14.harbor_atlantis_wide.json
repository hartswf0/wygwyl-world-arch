{
 "id": "harbor_atlantis_wide",
 "poem": "14",
 "name": "the whole harbor, everything he built",
 "look": "the harbor at dusk: Atlantis spire towers along the water, the white temple on its rise on the far shore, the pier arm, a moored boat, the caf\u00e9 quay from 13",
 "light": "cold dusk blue; red beacons on the spires; the haze is pale blue-grey and rises from the waterline, swallowing by height, not by time",
 "dossier_layers": {
  "sky": "dusk blue with a crescent",
  "back": "Atlantis spire skyline with beacons",
  "mid": "the white temple on its rise, the pier arm and boat, mirrored in water",
  "front": "the quay where he stands, back to us",
  "floor": "water and quay; the haze is a coded claim climbing from here through every layer"
 },

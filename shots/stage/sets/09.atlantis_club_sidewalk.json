{
 "id": "atlantis_club_sidewalk",
 "poem": "09",
 "name": "the club sidewalk",
 "look": "wet Atlantis street outside the clubs: neon doorways, power lines, a crowd along the curb, puddles mirroring red and blue",
 "light": "neon red and teal spill from doorways, wet reflections on the floor",

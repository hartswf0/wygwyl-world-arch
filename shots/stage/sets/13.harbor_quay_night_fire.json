{
 "id": "harbor_quay_night_fire",
 "poem": "13",
 "name": "the quay at night, the letter fire",
 "look": "the same quay stones at night, a small fire of sticks where five letters burn, black water and cyan lamps behind",
 "light": "the fire is the only warm light; cold cyan lamps behind; pale smoke rising across the lamps",
 "dossier_layers": {
  "sky": "black-navy, no moons visible through the smoke",
  "back": "pier lamps in cyan, orange reflections",
  "mid": "black water",
  "front": "the fire and the letter heap; the poet crouched",
  "floor": "wet quay stones lit orange in a small circle"
 },

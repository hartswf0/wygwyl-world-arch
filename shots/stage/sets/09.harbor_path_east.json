{
 "id": "harbor_path_east",
 "poem": "09",
 "name": "the quay path east",
 "look": "the quay path running east to the harbour mouth, a trail of worn prints in the stone, pre-dawn to sunrise",
 "light": "sky re-bands from three tones to five as the east lightens; town lamps go out when the sun clears the water",
 "dossier_layers": {
  "sky": "dawn bands (slate to apricot)",
  "back": "far shore with the mouth gap and the half sun",
  "mid": "water with the sun's road",
  "front": "walkers",
  "floor": "wet stone with footprint cards"
 },

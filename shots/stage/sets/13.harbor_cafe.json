{
 "id": "harbor_cafe",
 "poem": "13",
 "name": "the corner caf\u00e9 at the harbor of the heavens (day, dusk, night)",
 "look": "a stone quay below the white temple; a small teahouse caf\u00e9 with lanterns and four small tables; mud flats with two moored boats; the water; a far shore with one gabled building and one window",
 "light": "day: warm stone and sun glint; dusk: cooling to bay blue, string lights coming on; night: navy with lantern gold; the far window is the one warm rectangle across the water",
 "dossier_layers": {
  "sky": "day-pale to bay-blue dusk; Jupiter low, moons appear",
  "back": "far shore with the gabled building and its window; the white temple on its rise",
  "mid": "water and mud flats with the tide line; two moored boats",
  "front": "caf\u00e9 facade with lanterns, four small tables and chairs, the quay rail",
  "floor": "wet stone quay flecked with reflected lights"
 },
 "interior": true,
 "void": false,

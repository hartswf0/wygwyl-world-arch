{
 "id": "atlantis_harbor_street",
 "poem": "09",
 "name": "the inner harbour quay",
 "look": "a stone quay with a lip over black water, two bollards, a ladder down the wall; far shore of low sheds, two masts and a crane jib; four town lamps with broken streaks under them",
 "light": "one tonal engine: the moon (later the sun) lays a road of light on the water; everything else in whole tonal steps",
 "dossier_layers": {
  "sky": "graded navy bands, moon card",
  "back": "far shore strip with sheds, masts, crane, gap for the harbour mouth",
  "mid": "water with lamp streak cards and the moon road",
  "front": "quay lip with bollards and ladder",
  "floor": "wet stone, darker nearest camera"
 },

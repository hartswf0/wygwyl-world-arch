{
 "id": "led_canopy_avenue",
 "poem": "09",
 "name": "the LED canyon (canopy over the club avenue)",
 "look": "the club avenue under a vault of moving colour: palms, packed shopfronts, a crowd, the canopy's underside filling the top third of frame",
 "light": "everything lit from above by the canopy's shifting magenta/teal/violet; neon strips on the shopfronts; wet floor doubles it",
 "dossier_layers": {
  "sky": "canopy underside: curved card with coded scrolling colour",
  "back": "far shopfront rows and the vanishing point",
  "mid": "palm silhouettes and lit shopfront cards with cut neon",
  "front": "crowd strips (heads and shoulders) sliding past",
  "floor": "glossy black wet-street card with reflection strips"
 },
 "interior": false,

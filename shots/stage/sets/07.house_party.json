{
 "id": "house_party",
 "poem": "07",
 "name": "the Atlantis house party",
 "look": "a container-built living room packed with guests: neon strips, haze, a bar along one side, the DJ booth on a raised landing at the foot of a stair, an LED star ceiling, a projection wall on painted brick, couches",
 "light": "cyan haze against magenta/amber neon; the meter and the DJ's piping rise with the poem; at the end a hard light/shadow split across the poet",
 "dossier_layers": {
  "sky": "LED star ceiling (stars as backlit holes that close one by one in M3)",
  "back": "projection wall on painted brick",
  "mid": "DJ booth on its landing; the crowd strip",
  "front": "the bar with the poet; foreground heads in silhouette",
  "floor": "dance floor catching magenta and cyan pools; the stage floor never moves"
 },

{
 "id": "night_field_parade",
 "poem": "05",
 "name": "the night field and the parade",
 "look": "the Nevermore field opened into a wide grass rise under a dense star sky; a convex horizon (the earth he asks for is a globe); the parade's lanterns are the only warm light",
 "light": "cool moonless blue key, warm lantern and star-orb pools moving with the parade; later dawn-gold raking from one side for 'sun-kissing my skin'",
 "dossier_layers": {
  "sky": "deep blue with the white-gold star cluster; named stars as cut holes backlit; constellation ties drawn only once both ends are named",
  "back": "black jagged spire/tree silhouette on the horizon and the small shut gate at the top of frame",
  "mid": "the rise of grass with the parade coming over it",
  "front": "blossom/grass cards framing the poet",
  "floor": "curved grass horizon card (sagging arc, the globe)"
 },

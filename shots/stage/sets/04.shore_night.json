{
 "id": "shore_night",
 "poem": "04",
 "name": "the night shore",
 "look": "ash over sand, charred stumps, tambourine pieces at the top of the trail, debris riding the swell, still trees behind",
 "light": "dusk paper sky going to night; the heart's pulse is the only accent",
 "dossier_layers": {
  "sky": "pale dusk paper with ravens",
  "back": "sea as horizontal wavefronts in perspective that fold tight as it calms",
  "mid": "stumps, still trees, remnants",
  "front": "trail of prints and the broken ring",
  "floor": "ash sand in three flat tones"
 },

{
 "id": "temple_grove",
 "poem": "12",
 "name": "the grove at the forest edge",
 "look": "the temple grounds where the hill's woods begin: three thick trunks, a dark canopy, picnic bulbs strung between them, a fog bank behind",
 "light": "cool dusk blue from above, warm points of the picnic bulbs, faint projected memories on the fog",

{
 "id": "temple_shore_terrace",
 "poem": "12",
 "name": "the temple's shore terrace at dusk",
 "look": "low stone steps and a broad wet terrace on the shoreline below the temple, open sea, hills across the water, a few warm lamps",
 "light": "dusk: indigo sky, a last warm band at the horizon, two lamps on the wall; wet floor picks up reflections",
 "dossier_layers": {
  "sky": "indigo dusk with the first stars, a band of Milky Way at the top",
  "back": "hills and a lit far shore across the water",
  "mid": "calm sea with a reflection strip; hanging-cloth line lifting in the wind at one side",
  "front": "stone steps with two wall lamps at left",
  "floor": "wet stone slabs, reflective"
 },

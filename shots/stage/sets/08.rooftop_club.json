{
 "id": "rooftop_club",
 "poem": "08",
 "name": "the rooftop club",
 "look": "an open-air rooftop over Atlantis: a tiled dance floor whose tiles pulse outward, lattice strobe towers, a railing ledge, the disc-spire skyline and a far mountain range beyond",
 "light": "strobes, blue and pink washes, then haze filling the room; at the end a quiet blue",
 "dossier_layers": {
  "sky": "night with violet mist",
  "back": "far mountains (two near-identical ranges) and the disc-spire skyline",
  "mid": "lattice strobe towers and the crowd",
  "front": "the ledge and railing",
  "floor": "tile grid that pulses outward from its own centre"
 },

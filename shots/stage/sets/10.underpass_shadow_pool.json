{
 "id": "underpass_shadow_pool",
 "poem": "10",
 "name": "the underpass shadow-pool",
 "look": "a tunnel under the market flooded ankle-deep, graffiti walls, patched ceiling, the market's white light at the far end, everything doubled in the water",
 "light": "one white source at the far end; the walls' neon tags faint; ceiling lamps as a dotted line streaming toward camera",
 "dossier_layers": {
  "sky": "none (ceiling card with lamp dots)",
  "back": "white light card at the tunnel mouth",
  "mid": "nested frame cards of graffiti walls",
  "front": "spray flecks off the wheel",
  "floor": "mirror card with the tunnel painted inverted"
 },

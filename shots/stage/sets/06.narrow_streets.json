{
 "id": "narrow_streets",
 "poem": "06",
 "name": "the narrow streets",
 "look": "narrow colonial streets (the Mexico City shoot) remade: painted walls, string lights, neon, long shadows, a street musician",
 "light": "low raking light for long shadows; rainbow bands thrown from the music; string-light points",
 "dossier_layers": {
  "sky": "thin strip between roofs where clouds loosen and drift up",
  "back": "far end of the street",
  "mid": "walls with painted panels and windows",
  "front": "string lights and a doorway edge",
  "floor": "stone with rainbow and shadow gobos"
 },

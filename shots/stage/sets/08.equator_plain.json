{
 "id": "equator_plain",
 "poem": "08",
 "name": "the equator plain",
 "look": "an endless flat plain on a planet so large its curve barely shows (a three-cell sag across the frame); equator ticks nailed into the ground; an enormous white sun; air blown off the sky until it stands in white",
 "light": "blinding top light; heat shimmer; later a cold pool and steam",
 "dossier_layers": {
  "sky": "thick air bands that blow away dot by dot",
  "back": "the barely curved horizon",
  "mid": "heat ripples stacked in the air",
  "front": "the soul",
  "floor": "red-white ground with equator ticks; the pool spreading"
 },

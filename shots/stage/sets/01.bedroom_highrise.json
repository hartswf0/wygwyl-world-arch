{
 "id": "bedroom_highrise",
 "poem": "01",
 "name": "the high-rise bedroom",
 "look": "plain, dim, bare walls, a dresser, a hallway door with a vanishing point that will not sit still, a window onto the fire escape",
 "light": "one low warm lamp, the TV's blue flicker, cold city spill from the window",
 "dossier_layers": {
  "sky": "fog-drowned high-rises with a few warm windows",
  "back": "the hallway in forced perspective, its far door on a slider",
  "mid": "dresser with sliding drawers, TV on a low stand",
  "front": "the window frame on its slider and the fire-escape rail",
  "floor": "broken floorboard strip, dark"
 },

{
 "id": "temple_hall",
 "poem": "12",
 "name": "the white temple hall",
 "look": "inside the temple from 11: bone-white walls of arched lit niches, an open colonnade onto the shore and pool, long low dark-wood benches, a wall screen; warm evening light",
 "light": "warm sandstone evening light raking through the colonnade from the left; niches self-lit; for ELDERS the whole hall goes to black and drains back from the top",
 "dossier_layers": {
  "sky": "evening sky seen through the colonnade, pale gold to blue",
  "back": "white wall of arched lit niches; the tall niche with the hourglass shelf at centre; the wall screen to one side",
  "mid": "colonnade pillars as a regular row of cards; for ELDERS a black star-flecked drop with elder cut-outs flies in here",
  "front": "low dark-wood benches, the ring of friends",
  "floor": "pale stone with a mirror strip of pool water at the colonnade edge"
 },
 "interior": true,
 "void": false,

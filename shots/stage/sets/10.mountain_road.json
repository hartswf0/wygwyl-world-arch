{
 "id": "mountain_road",
 "poem": "10",
 "name": "the mountain road",
 "look": "switchbacks around Atlantis, a nest tree at the roadside, the road forking ahead; the sky being replaced by morning",
 "light": "a travelling dithered front of dawn sweeps across; after it, paper sky and a gold sun",
 "dossier_layers": {
  "sky": "night card with a ragged dawn-front edge pulled across, paper behind",
  "back": "mountain ridges in two tones",
  "mid": "nest tree, flock",
  "front": "bike",
  "floor": "road lines that split into two forks"
 },

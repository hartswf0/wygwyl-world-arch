{
 "id": "winged_marble_gate",
 "poem": "05",
 "name": "the winged marble gate",
 "look": "a colossal white marble gate in the night field; two leaves carved as folded wings, book-matched veining that is the same twelve ties of the constellation; opens toward camera, stone turning to feathered ribs",
 "light": "hymn-light ripples across the stone as broken rings; the heir-light through the seam; a far neon glow beyond",
 "dossier_layers": {
  "sky": "night, star cluster thinning to the city glow",
  "back": "the far Atlantis glow (copper and neon on water)",
  "mid": "the ancestors in a row beyond the threshold under their name plates",
  "front": "the two leaves, hinged off frame so they swing toward us",
  "floor": "threshold of dark stone with stars in it"
 },
 "interior": false,
 "void": false,

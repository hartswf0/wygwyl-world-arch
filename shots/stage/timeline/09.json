all on my father.","w":[177,184]},{"t":76.51,"e":79.05,"text":"Summon his calming demeanor from the yonders","w":[185,191]},{"t":79.99,"e":83.45,"text":"and we walk for years and travel east toward the sunrises","w":[192,202]},{"t":84.47,"e":87.57,"text":"and retrace his footsteps now and then.","w":[203,209]},{"t":88.56,"e":91.86,"text":"Guiding a settling down moon the way it used to leave","w":[210,220]},{"t":91.86,"e":95.08,"text":"and my tears fall between the creases","w":[221,227]},{"t":95.08,"e":97.18,"text":"and wave shadows of the inner harbor.","w":[228,234]},{"t":98.39,"e":100.57,"text":"We stroll, father and son,","w":[235,239]},{"t":101.31,"e":102.57,"text":"hearted and shaken.","w":[240,242]},{"t":103.51,"e":105.71,"text":"Someone borrowed and someone blew.","w":[243,247]}],"book":["I call on my Father","& travel east toward the","of the inner harbor—","Father & son,"],"match":{"how":"anchored","book_tokens":15,"anchored":15,"coverage":1.0,"span":[74.48,100.57],"first_word":"I"},"cues":[{"t":75.0,"w":184,"word":"father.","layer":"../poems/refs/atlas/views/085.jpg","action":"show","auto":true,"fx":"wipe","why":"a word of the scene name"},{"t":78.33,"w":188,"word":"demeanor","layer":"../poems/refs/atlas/views/085.jpg","action":"hide","auto":true,"fx":"wipe","why":"end of the line","dt":0.76},{"t":80.45,"w":194,"word":"walk","layer":"anim/clips/poet_tracksuit/ACT-001.json","action":"play","auto":true,"mode":"once","why":"verb"},{"t":80.45,"w":194,"word":"walk","layer":"poet.14.exit/1-stand#1","action":"hide","auto":true,"why":"the moving figure replaces the still"}]},{"key":"09.5","name":"The EX turns to haze","book_index":5,"t0":106.0833,"t1":108.82,"lines":[{"t":106.37,"e":108.25,"text":"Yet broken, yet hurt.","w":[248,251]}],"book":["yet, broken—","yet, heard."],"match":{"how":"anchored","book_tokens":4,"anchored":3,"coverage":0.75,"span":[106.37,107.97],"first_word":"Yet"},"cues":[{"t":106.69,"w":249,"word":"broken,","layer":"anim/clips/poet_tracksui
8,"e":17.6,"text":"and settle down the stillnessism.","w":[39,43]},{"t":18.9,"e":21.28,"text":"We talk for years and travel through time","w":[44,51]},{"t":21.8,"e":22.9,"text":"and it feels so good.","w":[52,56]},{"t":23.71,"e":24.73,"text":"We grow old together.","w":[57,60]},{"t":24.91,"e":27.63,"text":"I believe maybe we could have it all,","w":[61,68]},{"t":27.83,"e":31.11,"text":"or swing in my humbled late nights and heartbreaks","w":[69,77]},{"t":31.79,"e":33.45,"text":"and an end story unchanging.","w":[78,82]}],"book":["we look at the moon—","the way we used to see it","we talk for years","& travel through time"],"match":{"how":"anchored","book_tokens":19,"anchored":19,"coverage":1.0,"span":[12.63,21.28],"first_word":"we"},"cues":[{"t":12.4167,"layer":"09.props.suitcases-notice/chalk-overlay-1-with-time","action":"hide","auto":true,"why":"held back until named"},{"t":15.76,"w":40,"word":"settle","layer":"anim/clips/poet_tracksuit/ACT-001.json","action":"play","auto":true,"mode":"once","why":"fallback: second line"},{"t":15.76,"w":40,"word":"settle","layer":"poet.14.exit/1-stand","action":"hide","auto":true,"why":"the moving figure replaces the still"},{"t":20.9,"w":51,"word":"time","layer":"09.props.suitcases-notice/chalk-overlay-1-with-time","action":"show","auto":true,"fx":"pop","why":"named in her line"},{"t":23.97,"w":58,"word":"grow","layer":"../poems/refs/atlas/views/062.jpg","action":"show","auto":true,"fx":"wipe","why":"mid-scene"},{"t":26.47,"w":64,"word":"we","layer":"../poems/refs/atlas/views/062.jpg","action":"hide","auto":true,"fx":"wipe","why":"end of the line","dt":0.6}]},{"key":"09.2","name":"Suitcases at the phone booth","book_index":2,"t0":34.7917,"t1":38.6667,"lines":[{"t":35.1,"e":36.8,"text":"You help me gather my things to go.","w":[83,90]},{"t":37.98,"e":38.58,"text":"Before I go,","w":[91,93]}],"book":["You help me","gather my things to go.","before I go—"],"match":{"how":"anchored","book_tokens":11,"anchored":11,"coverage":1.0,"spa
]},{"t":112.02,"e":113.68,"text":"I do believe I'll be alright.","w":[258,263]},{"t":115.24,"e":121.84,"text":"This reclaimed and dust settled heart rediscovered but dusted hands remind me","w":[264,275]},{"t":121.84,"e":126.12,"text":"but say to me in this still muted tree in night garden","w":[276,287]},{"t":126.12,"e":128.74,"text":"feels silence nevermore.","w":[288,290]},{"t":129.26,"e":129.9,"text":"Now go.","w":[291,292]}],"book":["nevermore.","I have won at the world / & lost my soul—","I want nothing more / that to just be / myself—","Now go."],"match":{"how":"anchored","book_tokens":21,"anchored":16,"coverage":0.76,"span":[98.96,129.9],"first_word":"nevermore."},"cues":[{"t":117.64,"w":269,"word":"heart","layer":"poet.04.main-poses/04-6-rise-flex-reflect","action":"pose-swap","auto":true,"part":"poet.04.main-poses/04-2-heart-seated","why":"her word names the pose"}]}]}
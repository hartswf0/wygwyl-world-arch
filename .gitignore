# Heavy intermediate cutout rasters (regenerated via multiplane.py / film_render.py)
# Note: shots/world/*.webp contains the compressed 3D multiplane cards (23MB total)
# and shots/film/*.mp4 contains the compiled animatics (22MB total).
shots/out/*/multiplane/S*_P*.png
shots/out/*/layers/*.png

# Heavy intermediate render frames & raw gaussian ply
shots/video/
shots/out/*/scene_gs.ply


# weave: render scratch and re-fetchable archive candidates (see shots/weave/source_manifest.json)
shots/weave/frames/
shots/weave/archive/*.mp4
!shots/weave/archive/da69b1ba-1eb8-5072-8cf7-19fc272eba0f.mp4
shots/weave/archive/*.wav
!shots/weave/archive/6bb6d333-facb-5c4e-b540-0c150f87833b.mp4
shots/weave/*/frames/
shots/weave/p04_hands/archive/raw/
shots/weave/__pycache__/
